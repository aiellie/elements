{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "aiellie",
  "homepage": "https://elements.aiellie.dev",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper every element uses to merge class names.",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "registry/aiellie/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "models",
      "type": "registry:lib",
      "title": "Models",
      "description": "The model catalogue a selector is handed: the option shape, the vendor headings, the grouping, and a list to start from.",
      "registryDependencies": ["@aiellie/model-icons"],
      "files": [
        {
          "path": "registry/aiellie/lib/models.ts",
          "type": "registry:lib",
          "target": "lib/models.ts"
        }
      ]
    },
    {
      "name": "model-icons",
      "type": "registry:component",
      "title": "Model Icons",
      "description": "The vendor marks, keyed by vendor, drawn here rather than looked up in an icon set.",
      "files": [
        {
          "path": "registry/aiellie/icons/model-icons.tsx",
          "type": "registry:component",
          "target": "components/aiellie/icons/model-icons.tsx"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Base UI's button with this registry's variants and sizes on it.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/ui/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ],
      "categories": ["actions"]
    },
    {
      "name": "tooltip",
      "type": "registry:ui",
      "title": "Tooltip",
      "description": "Base UI's tooltip with this registry's popup and arrow on it.",
      "dependencies": ["@base-ui/react", "tw-animate-css"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/ui/tooltip.tsx",
          "type": "registry:ui",
          "target": "components/ui/tooltip.tsx"
        }
      ],
      "docs": "The open and close animations come from tw-animate-css. Add `@import \"tw-animate-css\";` to your global stylesheet if it is not there already.",
      "categories": ["overlays"]
    },
    {
      "name": "menu",
      "type": "registry:component",
      "title": "Menu",
      "description": "Base UI's menu with this registry's surface on it, plus an optional search box that filters the rows.",
      "dependencies": [
        "@base-ui/react",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/components/menu.tsx",
          "type": "registry:component",
          "target": "components/aiellie/menu.tsx"
        }
      ],
      "categories": ["overlays"]
    },
    {
      "name": "toolbar",
      "type": "registry:component",
      "title": "Toolbar",
      "description": "Base UI's toolbar with this registry's surface on it, plus buttons that name themselves in a tooltip.",
      "dependencies": ["@base-ui/react"],
      "registryDependencies": ["@aiellie/tooltip", "@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/components/toolbar.tsx",
          "type": "registry:component",
          "target": "components/aiellie/toolbar.tsx"
        }
      ],
      "categories": ["actions"]
    },
    {
      "name": "status",
      "type": "registry:component",
      "title": "Status",
      "description": "A labelled state pill with an optional pulsing indicator.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/components/status.tsx",
          "type": "registry:component",
          "target": "components/aiellie/status.tsx"
        }
      ],
      "categories": ["feedback"]
    },
    {
      "name": "tooltip-icon-button",
      "type": "registry:component",
      "title": "Tooltip Icon Button",
      "description": "An icon button that carries its own tooltip and screen-reader label.",
      "registryDependencies": [
        "@aiellie/button",
        "@aiellie/tooltip",
        "@aiellie/utils"
      ],
      "files": [
        {
          "path": "registry/aiellie/components/tooltip-icon-button.tsx",
          "type": "registry:component",
          "target": "components/aiellie/tooltip-icon-button.tsx"
        }
      ],
      "categories": ["actions"]
    },
    {
      "name": "model-selector",
      "type": "registry:component",
      "title": "Model Selector",
      "description": "A simple model selector component",
      "dependencies": ["@hugeicons/react", "@hugeicons/core-free-icons"],
      "registryDependencies": [
        "@aiellie/button",
        "@aiellie/menu",
        "@aiellie/model-icons",
        "@aiellie/models"
      ],
      "files": [
        {
          "path": "registry/aiellie/components/model-selector.tsx",
          "type": "registry:component",
          "target": "components/aiellie/model-selector.tsx"
        }
      ],
      "meta": {
        "icon": "AiBrain01Icon",
        "iframeHeight": "400px"
      },
      "categories": ["inputs"]
    },
    {
      "name": "chat",
      "type": "registry:block",
      "title": "Chat",
      "description": "A simple chat block",
      "files": [
        {
          "path": "registry/aiellie/blocks/chat/page.tsx",
          "type": "registry:page",
          "target": "app/chat/page.tsx"
        }
      ],
      "meta": {
        "icon": "Hold05Icon",
        "iframeHeight": "500px"
      },
      "categories": ["chat"]
    }
  ]
}
