{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "aiellie",
  "homepage": "https://elements.aiellie.dev",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper every element uses to merge class names.",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Base UI's button with this registry's variants and sizes on it.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "components/ui/button.tsx",
          "type": "registry:ui"
        }
      ],
      "categories": ["controls"]
    },
    {
      "name": "kbd",
      "type": "registry:ui",
      "title": "Kbd",
      "description": "A keystroke, and a group to set several of them side by side.",
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "components/ui/kbd.tsx",
          "type": "registry:ui"
        }
      ],
      "categories": ["display"]
    },
    {
      "name": "tooltip",
      "type": "registry:ui",
      "title": "Tooltip",
      "description": "Base UI's tooltip with this registry's popup and arrow on it.",
      "dependencies": ["@base-ui/react", "tw-animate-css"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "components/ui/tooltip.tsx",
          "type": "registry:ui"
        }
      ],
      "docs": "The open and close animations come from tw-animate-css. Add `@import \"tw-animate-css\";` to your global stylesheet if it is not there already.",
      "categories": ["overlay"]
    },
    {
      "name": "menu",
      "type": "registry:ui",
      "title": "Menu",
      "description": "Base UI's menu with this registry's surface on it, plus an optional search box that filters the rows.",
      "dependencies": [
        "@base-ui/react",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "components/aiellie/menu.tsx",
          "type": "registry:ui"
        }
      ],
      "categories": ["overlay", "navigation"]
    },
    {
      "name": "status",
      "type": "registry:ui",
      "title": "Status",
      "description": "A labelled state pill with an optional pulsing indicator.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "components/aiellie/status.tsx",
          "type": "registry:ui"
        }
      ],
      "categories": ["display"]
    },
    {
      "name": "tooltip-icon-button",
      "type": "registry:ui",
      "title": "Tooltip Icon Button",
      "description": "An icon button that carries its own tooltip and screen-reader label.",
      "registryDependencies": [
        "@aiellie/button",
        "@aiellie/tooltip",
        "@aiellie/utils"
      ],
      "files": [
        {
          "path": "components/aiellie/tooltip-icon-button.tsx",
          "type": "registry:ui"
        }
      ],
      "categories": ["controls"]
    },
    {
      "name": "hello-world",
      "type": "registry:block",
      "title": "Hello World",
      "description": "A simple hello world page",
      "files": [
        {
          "path": "registry/aiellie/blocks/hello-world/page.tsx",
          "type": "registry:page",
          "target": "app/hello-world/page.tsx"
        }
      ],
      "meta": {
        "icon": "Hold05Icon",
        "iframeHeight": "500px"
      }
    }
  ]
}
