{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "aiellie",
  "homepage": "https://elements.aiellie.dev",
  "items": [
    {
      "name": "chat",
      "type": "registry:block",
      "title": "Chat",
      "description": "A simple chat block",
      "files": [
        {
          "path": "registry/aiellie/blocks/chat/page.tsx",
          "type": "registry:page",
          "target": "app/chat/page.tsx"
        }
      ],
      "meta": {
        "icon": "Hold05Icon",
        "iframeHeight": "500px"
      }
    },
    {
      "name": "models",
      "type": "registry:lib",
      "title": "Models",
      "description": "The model catalogue a selector is handed: the option shape, the vendor headings, the grouping, and a list to start from.",
      "files": [
        {
          "path": "registry/aiellie/lib/models.ts",
          "type": "registry:lib"
        },
        {
          "path": "registry/aiellie/components/icons/model-icons.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "model-selector",
      "type": "registry:component",
      "title": "Model Selector",
      "description": "A simple model selector component",
      "dependencies": [
        "@base-ui/react",
        "@hugeicons/core-free-icons",
        "@hugeicons/react",
        "class-variance-authority"
      ],
      "files": [
        {
          "path": "registry/aiellie/components/model-selector.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/aiellie/components/menu.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/aiellie/components/icons/model-icons.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/aiellie/lib/models.ts",
          "type": "registry:lib"
        },
        {
          "path": "registry/aiellie/ui/button.tsx",
          "type": "registry:ui"
        }
      ],
      "meta": {
        "icon": "AiBrain01Icon",
        "iframeHeight": "400px"
      }
    }
  ]
}
