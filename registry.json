{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "aiellie",
  "homepage": "https://elements.aiellie.dev",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper every element uses to merge class names.",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "registry/aiellie/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Base UI's button with this registry's variants and sizes on it.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/ui/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ],
      "categories": ["controls"]
    },
    {
      "name": "menu",
      "type": "registry:ui",
      "title": "Menu",
      "description": "Base UI's menu with this registry's surface on it, plus an optional search box that filters the rows.",
      "dependencies": [
        "@base-ui/react",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "registryDependencies": ["@aiellie/utils"],
      "files": [
        {
          "path": "registry/aiellie/components/menu.tsx",
          "type": "registry:ui",
          "target": "components/aiellie/menu.tsx"
        }
      ],
      "categories": ["overlay", "navigation"]
    },
    {
      "name": "model-icons",
      "type": "registry:component",
      "title": "Model Icons",
      "description": "The vendor marks, keyed by vendor, drawn here rather than looked up in an icon set.",
      "files": [
        {
          "path": "registry/aiellie/components/icons/model-icons.tsx",
          "type": "registry:component",
          "target": "components/aiellie/icons/model-icons.tsx"
        }
      ],
      "categories": ["display"]
    },
    {
      "name": "models",
      "type": "registry:lib",
      "title": "Models",
      "description": "The model catalogue a selector is handed: the option shape, the vendor headings, the grouping, and a list to start from.",
      "registryDependencies": ["@aiellie/model-icons"],
      "files": [
        {
          "path": "registry/aiellie/lib/models.ts",
          "type": "registry:lib",
          "target": "lib/models.ts"
        }
      ]
    },
    {
      "name": "model-selector",
      "type": "registry:component",
      "title": "Model Selector",
      "description": "A simple model selector component",
      "dependencies": ["@hugeicons/react", "@hugeicons/core-free-icons"],
      "registryDependencies": [
        "@aiellie/button",
        "@aiellie/menu",
        "@aiellie/model-icons",
        "@aiellie/models"
      ],
      "files": [
        {
          "path": "registry/aiellie/components/model-selector.tsx",
          "type": "registry:component",
          "target": "components/aiellie/model-selector.tsx"
        }
      ],
      "meta": {
        "icon": "AiBrain01Icon",
        "iframeHeight": "400px"
      },
      "categories": ["controls"]
    },
    {
      "name": "chat",
      "type": "registry:block",
      "title": "Chat",
      "description": "A simple chat block",
      "files": [
        {
          "path": "registry/aiellie/blocks/chat/page.tsx",
          "type": "registry:page",
          "target": "app/chat/page.tsx"
        }
      ],
      "meta": {
        "icon": "Hold05Icon",
        "iframeHeight": "500px"
      }
    }
  ]
}
