# Copy this file to .env.local and fill in what you use. Without any key, the
# chat streams sample replies.

# One key for every model on the Vercel AI Gateway.
# Make one at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
AI_GATEWAY_API_KEY=

# A maker's own key has its models called directly instead of through the
# Gateway. Each is optional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
